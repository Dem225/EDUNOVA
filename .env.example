# ============================================================
# EDUNOVA — exemple de configuration
# ============================================================
# Copier ce fichier puis renseigner les valeurs localement.
# Ne jamais committer le fichier .env réel.
# Les valeurs ci-dessous sont fictives : remplacez CHANGER_MOI.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=EDUNOVA
# development | staging | production
# Alias acceptés : dev/local -> development, stage -> staging, prod -> production.
APP_ENV=development

# URL PostgreSQL utilisée par SQLAlchemy et Alembic.
# Format : postgresql+psycopg://utilisateur:mot_de_passe@hote:port/base
DATABASE_URL=postgresql+psycopg://edunova:CHANGER_MOI@localhost:5432/edunova

# ------------------------------------------------------------
# Secrets
# ------------------------------------------------------------
# SECRET_KEY sert a signer les tokens JWT.
# Obligatoire en staging et production (au moins 32 caractères).
# À générer localement, sans coller la valeur dans ce fichier ni dans un rapport.
SECRET_KEY=CHANGER_MOI_AVEC_UNE_VALEUR_ALEATOIRE_D_AU_MOINS_32_CARACTERES

# INSTALLATION_TOKEN autorise la commande CLI de creation du premier super administrateur.
# Obligatoire en staging et production (au moins 32 caractères).
# Il ne doit jamais être affiché dans un terminal partagé ni versionné.
INSTALLATION_TOKEN=CHANGER_MOI_AVEC_UNE_VALEUR_ALEATOIRE_D_AU_MOINS_32_CARACTERES

# ------------------------------------------------------------
# Journalisation et documentation
# ------------------------------------------------------------
# SQL_ECHO=false en configuration normale.
# Même si mis à true, il est ignoré hors développement.
SQL_ECHO=false

# true en developpement ; force a false en production.
DOCS_ENABLED=true

# Format JSON attendu par pydantic-settings.
# Le joker "*" est interdit en production.
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:5501"]

# ------------------------------------------------------------
# Tokens et mots de passe
# ------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_HOURS=24

PASSWORD_MIN_LENGTH=14
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ------------------------------------------------------------
# Limites de sécurité
# ------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_RESET_PER_HOUR=3
RATE_LIMIT_APPLICATIONS_PER_MINUTE=5

# ------------------------------------------------------------
# Rate limiting des candidatures
# ------------------------------------------------------------
# memory uniquement en developpement ; redis obligatoire en staging/production.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_IP_MAX=5
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_MAX=3
RATE_LIMIT_EMAIL_WINDOW_SECONDS=900

# URL Redis (peut contenir un mot de passe : ne jamais la coller dans un rapport).
# Format : redis://[[utilisateur:]mot_de_passe@]hote:port/0
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5
REDIS_HEALTH_CHECK_INTERVAL=30

# Secret HMAC dedie aux cles de limitation, distinct de SECRET_KEY et de
# INSTALLATION_TOKEN, 32 caracteres minimum. Obligatoire en staging/production.
# La rotation de ce secret reinitialise les compteurs actifs.
RATE_LIMIT_HMAC_SECRET=CHANGER_MOI_AVEC_UNE_VALEUR_ALEATOIRE_D_AU_MOINS_32_CARACTERES

# IP/CIDR des proxies de confiance, AU FORMAT JSON (liste), pas CSV :
# pydantic-settings decode ce champ avec json.loads. "10.0.0.1,10.0.1.0/24"
# est invalide et fait echouer le demarrage.
# Le joker "*" est interdit. Ces valeurs sont transmises automatiquement a
# Uvicorn par backend/run.py via forwarded_allow_ips : aucune recopie manuelle.
# Exemple : TRUSTED_PROXY_IPS=["10.0.0.1","10.0.1.0/24"]
TRUSTED_PROXY_IPS=[]

# Lancement PowerShell depuis la racine du depot :
#   uv run python backend/run.py
# proxy_headers est active uniquement si TRUSTED_PROXY_IPS est non vide.
